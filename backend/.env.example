APP_PORT=8080
APP_ENV=development
JWT_SECRET=change-this-development-secret-at-least-32-chars
JWT_ACCESS_EXPIRE_MIN=30
JWT_REFRESH_EXPIRE_HOUR=168
BOOKING_HOLD_MINUTES=10
CANCEL_POLICY_HOURS=12

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=badminton
POSTGRES_SSLMODE=disable

SQLITE_PATH=badminton_dev.db
ALLOW_SQLITE_FALLBACK=true

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REQUIRE_REDIS=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_MAX_OPEN_CONNS=40
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=30
HTTP_IDLE_TIMEOUT_SEC=60
DEMO_SEED_ENABLED=false
